import /vendor/etc/init/hw/init.aries.usb.rc

on early-init
    mount debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug

on init
    # lower the screen-off memory pressure of the 3.0 kernel's KSM
    write /sys/kernel/mm/ksm/pages_to_scan 100
    write /sys/kernel/mm/ksm/sleep_millisecs 500
    write /sys/kernel/mm/ksm/run 1

# MFC (video) and FIMC (camera) memory: allocated by the drivers when opened
# and given back to the system while unused
on property:sys.boot_completed=1
    write /sys/kernel/uacma/ondemand 1

on fs
    exec -- /system/bin/sh /vendor/bin/aries-mtd.sh
    mount_all /vendor/etc/fstab.aries --early

    # The efs and radio MTD partitions are NOT mounted: on phones coming from
    # the stock firmware they are not in the yaffs2 format this kernel reads
    # ("chunk not erased"), and a read-write yaffs2 mount writes to them. The
    # modem firmware comes from /vendor/firmware instead (s1q-modem.sh) and
    # /efs from the factory EFS (post-fs-data).

on late-fs
    mount_all /vendor/etc/fstab.aries --late

on post-fs
    # SGX540 services (microkernel load) before SurfaceFlinger (class core, on boot)
    exec_start pvrsrvinit
    # modem firmware for libsec-ril (/dev/block/bml12)
    exec u:r:shell:s0 root root -- /system/bin/sh /vendor/bin/s1q-modem.sh

on post-fs-data
    setprop vold.post_fs_data_done 1
    # /efs (nv_data.bin with the IMEI, imei/, Bluetooth address) for the
    # modem: rebuilt once from the phone's factory EFS (read-only "efs_stock"
    # MTD, Samsung FSR STL + RFS) into /data/vendor/efs, then bind mounted.
    # Wiping data just makes it copy them again.
    exec u:r:shell:s0 root root -- /vendor/bin/s1q_efs_migrate /data/vendor/efs
    mkdir /data/vendor/efs 0775 radio radio
    restorecon_recursive /data/vendor/efs
    mount none /data/vendor/efs /efs bind
    # GPS
    mkdir /data/gps 0770 gps system
    chown gps system /sys/class/sec/gps/GPS_PWR_EN/value
    chmod 0660 /sys/class/sec/gps/GPS_PWR_EN/value
    chown gps system /sys/class/sec/gps/GPS_nRST/value
    chmod 0660 /sys/class/sec/gps/GPS_nRST/value
    # Wi-Fi
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    # the Wi-Fi HAL (user wifi) selects the STA/AP firmware here
    chown wifi wifi /sys/module/bcmdhd/parameters/firmware_path
    chmod 0660 /sys/module/bcmdhd/parameters/firmware_path
    # Bluetooth address (the RIL used to provide it)
    mkdir /data/vendor/bluetooth 0770 bluetooth bluetooth
    exec u:r:shell:s0 bluetooth bluetooth -- /system/bin/sh /vendor/bin/s1q-bdaddr.sh

# Diagnostics for bug reports, off by default: logs to /data/s1qlog, copied to
# <microSD>/s1qlog every minute (see s1q-diag.sh). Enable with
#   adb root && adb shell setprop persist.vendor.s1q.diag 1
on property:persist.vendor.s1q.diag=1
    mkdir /data/s1qlog 0777 root root
    start s1q_logcat
    start s1q_diag

on property:persist.vendor.s1q.diag=0
    stop s1q_logcat
    stop s1q_diag

on boot
    # Bluetooth: rfkill power for libbt-vendor (HAL runs as bluetooth)
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/type
    write /sys/block/mmcblk0/queue/add_random 0
    write /sys/block/mmcblk0/queue/scheduler noop
    chown system system /sys/class/backlight/s5p_bl/brightness
    chmod 0664 /sys/class/backlight/s5p_bl/brightness
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ondemand

on charger
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor powersave

# GPS (BCM4751): gpsd serves the gps.aries HAL on /dev/socket/gps
service gpsd /vendor/bin/gpsd -c /vendor/etc/gps.xml
    class main
    socket gps seqpacket 0660 gps system
    user gps
    group system inet wakelock
    seclabel u:r:shell:s0

service s1q_logcat /system/bin/logcat -b all -v threadtime -f /data/s1qlog/logcat.txt -r 4096 -n 3
    class main
    user root
    group log
    disabled
    seclabel u:r:shell:s0

service s1q_diag /system/bin/sh /vendor/bin/s1q-diag.sh
    class main
    user root
    group log
    disabled
    seclabel u:r:shell:s0

# Off-mode charging (bootloader sets INFORM5 -> androidboot.mode=charger).
# Long-pressing power continues the boot in place (ro.enable_boot_charger_mode):
# rebooting would land in LPM again while the charger is attached.
# Unplugging the cable in LPM powers the phone off (s5pc110_battery).
# (s1q_diag_charger: the same for off-mode charging, started by hand)

on property:sys.boot_from_charger_mode=1
    write /sys/class/power_supply/battery/charging_mode_booting 0

service s1q_diag_charger /system/bin/sh /vendor/bin/s1q-diag.sh charger
    user root
    disabled
    seclabel u:r:shell:s0

service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
        -O/data/vendor/wifi/wpa/sockets -dd -g@android:wpa_wlan0
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    interface android.hardware.wifi.supplicant@1.2::ISupplicant default
    socket wpa_wlan0 dgram 660 wifi wifi
    class main
    disabled
    oneshot

service pvrsrvinit /system/vendor/bin/pvrsrvinit
    user root
    group root graphics
    oneshot
    disabled
    seclabel u:r:shell:s0
